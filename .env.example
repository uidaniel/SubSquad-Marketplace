# Nothing here is required to run the app. With an empty file it starts in demo
# mode against seeded fixtures, with every provider mocked.

# Never sends a WhatsApp message, email, or charge while this is true.
DRY_RUN=true
# Force fixtures even when Supabase is configured.
DEMO_MODE=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Postgres, Auth, Storage, RLS) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Payments (Paystack: collections + Transfer API) ------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Messaging --------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
RESEND_API_KEY=
RESEND_FROM="SubSquad <hello@subsquad.ng>"

# --- Transcription ----------------------------------------------------------
DEEPGRAM_API_KEY=

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
